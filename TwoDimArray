		int arr[][] = new int[2][3];
        //initialize
		for (int i = 0; i < arr.length; i++) {
			for (int j = 0; j < arr[i].length; j++) {
				System.out.println("enter the value for row"+(i+1)+"column"+(j+1));
				arr[i][j]=sc.nextInt();
			}
		}
		//printing 
		for (int i = 0; i < arr.length; i++) {
			for (int j = 0; j < arr[i].length; j++) {
				System.out.print(arr[i][j]+" ");
