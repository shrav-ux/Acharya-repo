package javaproject;

import java.util.Scanner;

public class RangeCountArray {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		        Scanner sc = new Scanner(System.in);
		        int[][] arr = new int[3][3];

		        int count1to50 = 0;
		        int count50to100 = 0;
		        int countAbove100 = 0;

		        System.out.println("Enter 9 numbers:");

		        // Input into 2D array
		        for (int i = 0; i < 3; i++) {
		            for (int j = 0; j < 3; j++) {
		                arr[i][j] = sc.nextInt();

		                // Conditional checking
		                if (arr[i][j] >= 1 && arr[i][j] <= 50)
		                    count1to50++;
		                else if (arr[i][j] >= 51 && arr[i][j] <= 100)
		                    count50to100++;
		                else if (arr[i][j] > 100)
		                    countAbove100++;
		            }
		        }

		        // Output
		        System.out.println("Numbers between 1 to 50 : " + count1to50);
		        System.out.println("Numbers between 50 to 100 : " + count50to100);
		        System.out.println("Numbers above 100 : " + countAbove100);
		    }
		
	}


