package javaproject;

import java.util.Scanner;

public class bill {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
//input amount in bill if amount is greater than 1000 then add discount of 8% to bill amount 
//if  amount greater than 2000 then add discount of 15% to bill amount if amount is less than
		//1000 then no discount
		Scanner sc = new Scanner(System.in);
		System.out.println("enter the total amount");
		int amount = sc.nextInt();
		double discount=0;
		if(amount>=2000)
		{
			 discount=amount*0.15;
		}
		else if(amount>=1000) {
			discount=amount*0.08;
		}
		else 
		{
			discount= 0;
			System.out.println(discount);
			 
		}
		double finalamount=amount-discount;
		
		System.out.println("final amount to pay="+finalamount);
		
				
		
		
	}

}
